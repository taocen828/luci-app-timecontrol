#!/bin/sh
. /lib/functions.sh

CONF="timecontrol"
TIMECONTROL_ENABLE=0
TIMECONTROL_TYPE=0
TIMECONTROL_STRONG=0
TIMECONTROL_Action=1
IsUpdate=0
FW4=$(command -v fw4 2>/dev/null)
FW3_IP6=$(command -v ip6tables 2>/dev/null)
PIDFILE="/var/run/timecontrol.pid"
SLEEPTIME=60
RulesMACAddrList=""
DAILY_STATEFILE="/etc/timecontrol.daily"
DAILY_RUNTIME_STATE="/tmp/timecontrol.daily"
DAILY_PERSIST_INTERVAL=300
DAILY_PERSIST_ELAPSED=0
DAILY_RULE_CHANGED=0

iptables_w() {
    iptables -w 1 "$@" >/dev/null 2>&1
    [ -n "$FW3_IP6" ] && ip6tables -w 1 "$@" >/dev/null 2>&1
}

config_n_get() {
    local ret=$(uci -q get "${1}.${2}.${3}")
    echo "${ret:=$4}"
}

# Daily quota state is kept in volatile storage and checkpointed periodically.
# Format: section|date|used_minutes|counter_bytes
init_daily_state() {
    local today=$(date +%F)
    local tmp="${DAILY_RUNTIME_STATE}.new"
    : > "$tmp"
    while IFS='|' read -r section saved_date used saved_bytes; do
        [ -n "$section" ] || continue
        if [ "$saved_date" = "$today" ]; then
            printf '%s|%s|%s|%s\n' "$section" "$saved_date" "${used:-0}" "${saved_bytes:-0}" >> "$tmp"
        else
            printf '%s|%s|0|0\n' "$section" "$today" >> "$tmp"
        fi
    done < "$DAILY_STATEFILE" 2>/dev/null
    mv "$tmp" "$DAILY_RUNTIME_STATE"
}

daily_state_get() {
    local section="$1" field="$2" default="$3" line
    line=$(grep -E "^${section}[|]" "$DAILY_RUNTIME_STATE" 2>/dev/null | tail -n 1)
    [ -n "$line" ] || { echo "$default"; return; }
    case "$field" in
        date) echo "$line" | cut -d'|' -f2 ;;
        used) echo "$line" | cut -d'|' -f3 ;;
        bytes) echo "$line" | cut -d'|' -f4 ;;
        *) echo "$default" ;;
    esac
}

daily_state_set() {
    local section="$1" date_value="$2" used="$3" bytes="$4" tmp="${DAILY_RUNTIME_STATE}.new"
    awk -F '|' -v s="$section" '$1 != s' "$DAILY_RUNTIME_STATE" 2>/dev/null > "$tmp"
    printf '%s|%s|%s|%s\n' "$section" "$date_value" "$used" "$bytes" >> "$tmp"
    mv "$tmp" "$DAILY_RUNTIME_STATE"
}

persist_daily_state() {
    local tmp="${DAILY_STATEFILE}.new"
    awk -F '|' 'NF >= 4 && $1 != "" { print $1 "|" $2 "|" $3 "|" $4 }' "$DAILY_RUNTIME_STATE" 2>/dev/null > "$tmp"
    mv "$tmp" "$DAILY_STATEFILE"
    DAILY_PERSIST_ELAPSED=0
}

daily_counter_name() {
    echo "tc_daily_$1"
}

create_daily_counters() {
    [ -n "$FW4" ] || return 0
    config_foreach create_daily_counter rule
}

create_daily_counter() {
    local section="$1" enable macaddrlist interface
    enable=$(config_n_get "$CONF" "$section" "enable" 0)
    macaddrlist=$(config_n_get "$CONF" "$section" "macaddrlist")
    interface=$(config_n_get "$CONF" "$section" "interface")
    [ "$enable" -eq 1 ] 2>/dev/null || return 0
    [ -n "$macaddrlist" ] || return 0
    [ "$(config_n_get "$CONF" "$section" "dailyLimit" 0)" -gt 0 ] 2>/dev/null || return 0
    local counter=$(daily_counter_name "$section")
    nft "add counter inet fw4 $counter" >/dev/null 2>&1
    local macs=$(echo "$macaddrlist" | sed 's/ /,/g')
    nft "add rule inet fw4 timecontrol_quota iifname \"$interface\" ether saddr { ${macs} } counter name $counter" >/dev/null 2>&1
    nft "add rule inet fw4 timecontrol_quota oifname \"$interface\" ether daddr { ${macs} } counter name $counter" >/dev/null 2>&1
}

read_daily_counter_bytes() {
    local section="$1" bytes
    [ -n "$FW4" ] || { echo 0; return; }
    bytes=$(nft list counter inet fw4 "$(daily_counter_name "$section")" 2>/dev/null | awk '{for (i=1; i<=NF; i++) if ($i == "bytes") { print $(i+1); exit }}')
    case "$bytes" in *[!0-9]*|'') bytes=0;; esac
    echo "$bytes"
}

reset_daily_counter() {
    local section="$1"
    [ -n "$FW4" ] || return 0
    nft "reset counter inet fw4 $(daily_counter_name "$section")" >/dev/null 2>&1
}

update_daily_rule() {
    local section="$1" enable limit threshold today saved_date used previous current delta was_reached
    enable=$(config_n_get "$CONF" "$section" "enable" 0)
    limit=$(config_n_get "$CONF" "$section" "dailyLimit" 0)
    threshold=$(config_n_get "$CONF" "$section" "dailyThresholdKB" 64)
    [ "$enable" -eq 1 ] 2>/dev/null || return 0
    [ "$limit" -gt 0 ] 2>/dev/null || return 0
    today=$(date +%F)
    saved_date=$(daily_state_get "$section" date "$today")
    used=$(daily_state_get "$section" used 0)
    previous=$(daily_state_get "$section" bytes 0)
    was_reached=0
    daily_quota_reached "$section" && was_reached=1
    current=$(read_daily_counter_bytes "$section")
    [ "$saved_date" = "$today" ] || { used=0; previous=0; reset_daily_counter "$section"; }
    delta=$((current - previous))
    [ "$delta" -ge 0 ] || delta=$current
    [ "$delta" -ge $((threshold * 1024)) ] && used=$((used + 1))
    daily_state_set "$section" "$today" "$used" "$current"
    logger -t timecontrol "daily usage ${used}/${limit} minutes (ID: $section, delta: ${delta}B)"
    if daily_quota_reached "$section"; then
        [ "$was_reached" -eq 1 ] || DAILY_RULE_CHANGED=1
    elif [ "$was_reached" -eq 1 ]; then
        DAILY_RULE_CHANGED=1
    fi
}

daily_quota_reached() {
    local section="$1" limit used
    limit=$(config_n_get "$CONF" "$section" "dailyLimit" 0)
    used=$(daily_state_get "$section" used 0)
    [ "$limit" -gt 0 ] 2>/dev/null && [ "$used" -ge "$limit" ] 2>/dev/null
}

set_daily_quota_hooks() {
    [ -n "$FW4" ] || return 0
    local parent handles
    for parent in mangle_prerouting mangle_postrouting; do
        handles=$(nft -a list chain inet fw4 "$parent" 2>/dev/null | grep 'timecontrol_quota' | awk '{print $NF}')
        delete_nftablesRules "$handles" "$parent"
        nft "insert rule inet fw4 $parent counter jump timecontrol_quota comment \"!fw4: Time control daily quota\"" >/dev/null 2>&1
    done
}

update_daily_quotas() {
    load_config
    DAILY_RULE_CHANGED=0
    config_foreach update_daily_rule rule
    DAILY_PERSIST_ELAPSED=$((DAILY_PERSIST_ELAPSED + 60))
    [ "$DAILY_PERSIST_ELAPSED" -ge "$DAILY_PERSIST_INTERVAL" ] && persist_daily_state
    [ "$DAILY_RULE_CHANGED" -eq 1 ] && Initialize daily
}

convert_timeToUTC() {
    local input_time="$1"
    local current_time=$(date +%Y-%m-%d)
    #local system_timezone=$(config_n_get "system" "@system[-1]" "timezone" "UTC")
    #local timestamp=$(TZ=$system_timezone date -d "$current_time $input_time" +%s 2>/dev/null)
    local timestamp=$(date -d "$current_time $input_time" +%s 2>/dev/null)
    local utc_time=$(TZ=UTC date -d @$timestamp +%H:%M:%S)
    echo $utc_time
}

get_UTC_timerange() {
    start_time=$(echo "$1" | awk -F '-' '{print $1}')
    end_time=$(echo "$1" | awk -F '-' '{print $2}')
    start_utctime=$(convert_timeToUTC "$start_time")
    end_utctime=$(convert_timeToUTC "$end_time")
    
    if [ "$(date -d "$end_utctime" +%s)" -lt "$(date -d "$start_utctime" +%s)" ]; then
        if [ "$end_utctime" == "00:00:00" ]; then
            echo \"${start_utctime}\"-\"23:59:59\"
        else
            echo \"${start_utctime}\"-\"23:59:59\",\"00:00:00\"-\"${end_utctime}\"
        fi
    else
        echo \"${start_utctime}\"-\"${end_utctime}\"
    fi
}

load_config() {
    config_load "$CONF"
    TIMECONTROL_ENABLE=$(config_n_get "$CONF" "config" "enable" 0)
    TIMECONTROL_TYPE=$(config_n_get "$CONF" "config" "controlType" 0)
    TIMECONTROL_Action=$(config_n_get "$CONF" "config" "ruleAction" 0)
    
    if [ $TIMECONTROL_ENABLE -ne 1 ]; then
        logger -t timecontrol "timecontrol is disabled, exiting."
        exit 0
    fi
}

set_Rules() {
    local macaddrlist=$1
    local timerangelist=$2
    local days=$3
    local interfacelist=$4
    local ipsetname=$5
    local matchflag=$6 # 0: not match, 1: match
    local id=$7
    
    if [ -z "$FW4" ]; then
        local ether_saddr_param
        if [ -n "$macaddrlist" ]; then
            ipset create "$ipsetname" hash:mac
            for macaddr in $macaddrlist; do
                ipset add "$ipsetname" $macaddr
            done
            local match_param
            if [ $matchflag -eq 0 ]; then
                match_param="!"
            fi
            ether_saddr_param="-m set $match_param --match-set $ipsetname src"
        fi
        
        local weekdays_param
        if [ -n "$days" ]; then
            weekdays_param="--weekdays "$days""
        fi
        
        if [ -z "$timerangelist" ]; then
            timerangelist="00:00:00-23:59:59"
        fi
        
        for timerange in $timerangelist; do
            timeon=$(echo "$timerange" | awk -F '-' '{print $1}')
            timeoff=$(echo "$timerange" | awk -F '-' '{print $2}')
            
            local time_param
            if [ -n "$timeon" ] && [ -n "$timeoff" ]; then
                time_param="--timestart $timeon --timestop $timeoff"
            fi
            
            local chain target
            for table in filter nat; do
                case $table in
                    filter)
                        chain="timecontrol_forward"
                        if [ $TIMECONTROL_Action -eq 1 ]; then
                            target="reject"
                        else
                            target="DROP"
                        fi
                    ;;
                    nat)
                        chain="timecontrol_dstnat"
                        target="ACCEPT"
                    ;;
                    *) ;;
                esac
                if [ -n "$interfacelist" ]; then
                    for interface in $interfacelist; do
                        iifname_param="-i ${interface}"
                        iptables_w -t $table -A $chain $iifname_param $ether_saddr_param -m time --kerneltz $time_param $weekdays_param -j $target -m comment --comment "!fw3: Time control"
                    done
                else
                    iptables_w -t $table -A $chain $ether_saddr_param -m time --kerneltz $time_param $weekdays_param -j $target -m comment --comment "!fw3: Time control"
                fi
            done
        done
        
    else
        local ether_saddr_param
        if [ -n "$macaddrlist" ]; then
            macaddr=$(echo $macaddrlist | sed 's/ /,/g')
            local match_param
            if [ $matchflag -eq 0 ]; then
                match_param="!="
            fi
            ether_saddr_param="ether saddr $match_param { ${macaddr} } "
        fi
        
        local meta_hour_param
        if [ -n "$timerangelist" ]; then
            local utc_timeranges
            for timerange in $timerangelist; do
                if [ -z "$utc_timeranges" ]; then
                    utc_timeranges="$(get_UTC_timerange "$timerange")"
                else
                    utc_timeranges="${utc_timeranges},$(get_UTC_timerange "$timerange")"
                fi
            done
            meta_hour_param="meta hour { ${utc_timeranges} } "
        fi
        
        local meta_day_param
        if [ -n "$days" ]; then
            meta_day_param="meta day { ${days} } "
        fi
        
        local iifname_param
        if [ -n "$interfacelist" ]; then
            local interface=\"$(echo $interfacelist | sed 's/ /","/g')\"
            iifname_param="iifname { ${interface} } "
        fi
        
        local target
        if [ $TIMECONTROL_Action -eq 1 ]; then
            target="jump handle_reject"
        else
            target="drop"
        fi
        
        TZ=UTC nft "add rule inet fw4 timecontrol_forward ${ether_saddr_param} ${meta_hour_param} ${meta_day_param} ${iifname_param} counter ${target} comment \"!fw4: Time control\""
        TZ=UTC nft "add rule inet fw4 timecontrol_dstnat ${ether_saddr_param} ${meta_hour_param} ${meta_day_param} ${iifname_param} counter accept comment \"!fw4: Time control\""
    fi
    
    local log_MAC="MAC: AllClients;"
    if [ -n "$macaddrlist" ]; then
        log_MAC="MAC: $(echo $macaddrlist | sed 's/ /,/g'); "
    fi
    
    local log_timeranges="Time: AnyTime; "
    if [ -n "$timerangelist" ]; then
        log_timeranges="Time: $(echo $timerangelist | sed 's/ /,/g'); "
    fi
    
    local log_weekdays="Weekdays: AnyDay; "
    if [ -n "$days" ]; then
        log_weekdays="Weekdays: $(echo $days | sed 's/ /,/g'); "
    fi
    
    local log_interface="Interface: *"
    if [ -n "$interfacelist" ]; then
        log_interface="Interface: $(echo $interfacelist | sed 's/ /,/g')"
    fi
    
    local log_id
    if [ -n "$id" ]; then
        log_id="ID: $id; "
    fi
    
    logger -t timecontrol "added rule (${log_id}${log_MAC}${log_timeranges}${log_weekdays}${log_interface})"
}

delete_conntrack() {
    local macaddrlist=$1
    local interfacelist=$2
    local matchflag=$3 # 0: not match, 1: match
    
    if [ -n "$(command -v conntrack 2>/dev/null)" ]; then
        local match_param
        if [ $matchflag -eq 0 ]; then
            match_param="-v"
        fi
        
        mac_regex=$(echo ${macaddrlist} | sed 's/ /|/g')
        interface_regex=$(echo ${interfacelist} | sed 's/ /|/g')
        
        ipaddr_list=$(ip neigh | grep -i -E "${mac_regex}" $match_param | grep -i -E "${interface_regex}" | awk '{print $1}')
        for ipaddr in $ipaddr_list; do
            conntrack -D --orig-src "$ipaddr" >/dev/null 2>&1
        done
        
        if [ -n "$ipaddr_list" ]; then
            logger -t timecontrol "deleted conntrack entries for IPs: $(echo $ipaddr_list | sed 's/ /,/g')"
        fi
    fi
}

add_controlRules() {
    local enable=$(config_n_get "$CONF" "$1" "enable" 0)
    local macaddrlist=$(config_n_get "$CONF" "$1" "macaddrlist")
    local timerangelist=$(config_n_get "$CONF" "$1" "timerangelist")
    local weekdays=$(config_n_get "$CONF" "$1" "weekdays")
    local temporaryControl=$(config_n_get "$CONF" "$1" "temporaryControl" 0)
    local temporaryDuration=$(config_n_get "$CONF" "$1" "temporaryDuration" 0)
    local interface=$(config_n_get "$CONF" "$1" "interface")
    local dailyLimit=$(config_n_get "$CONF" "$1" "dailyLimit" 0)
    
    if [ $enable -ne 1 ]; then
        return 0
    fi
    
    if [ -n "$macaddrlist" ]; then
        if [ -z "$RulesMACAddrList" ]; then
            RulesMACAddrList="$macaddrlist"
        else
            RulesMACAddrList="$RulesMACAddrList $macaddrlist"
        fi
    fi
    
    # A reached daily quota overrides any temporary unblock.
    if daily_quota_reached "$1"; then
        temporaryDuration=0
        temporaryControl=1
    fi

    #temporary unblock
    if [ $temporaryDuration -gt 0 ] && [ $temporaryControl -eq 0 ]; then
        logger -t timecontrol "temporary unblock $temporaryDuration minutes (ID: $1)"
        return 0
    fi
    
    weekdays=$(echo "$weekdays" | sed 's/ /,/g')
    local days
    if [ "$weekdays" != "Sunday,Monday,Tuesday,Wednesday,Thursday,Friday,Saturday" ]; then
        days="$weekdays"
    fi
    
    #blacklist with no time and day limit
    if [ $TIMECONTROL_TYPE -ne 0 ] && [ -z "$timerangelist" ] && [ -z "$days" ] && [ $temporaryDuration -eq 0 ]; then
        return 0
    fi
    
    #temporary block
    if [ $temporaryDuration -gt 0 ] && [ $temporaryControl -eq 1 ]; then
        days=""
        timerangelist="00:00:00-23:59:59"
        logger -t timecontrol "temporary block $temporaryDuration minutes (ID: $1)"
    fi

    # A daily-only rule does not install an all-day blacklist rule.
    # The quota check below will still install the block once the limit is reached.
    if [ "$dailyLimit" -gt 0 ] 2>/dev/null && [ "$temporaryDuration" -eq 0 ] 2>/dev/null \
        && { [ -z "$timerangelist" ] || [ "$timerangelist" = "00:00:00-23:59:59" ]; } \
        && [ -z "$weekdays" ] && ! daily_quota_reached "$1"; then
        logger -t timecontrol "daily-only rule, no fixed time block (ID: $1)"
        return 0
    fi

    # Daily quota exhaustion is enforced through the existing per-device rule.
    if daily_quota_reached "$1"; then
        days=""
        timerangelist="00:00:00-23:59:59"
        logger -t timecontrol "daily quota reached, blocking rule (ID: $1)"
    fi
    
    set_Rules "$macaddrlist" "$timerangelist" "$days" "$interface" "${CONF}_maclist_$1" 1 "$1"
    delete_conntrack "$macaddrlist" "$interface" 1
}

add_rejectRule() {
    local rejectInterface=$(config_n_get "$CONF" "config" "rejectInterface")
    local timerangelist=$(config_n_get "$CONF" "config" "timerangelist")
    local weekdays=$(config_n_get "$CONF" "config" "weekdays")
    
    if [ -n "$RulesMACAddrList" ]; then
        RulesMACAddrList=$(echo $RulesMACAddrList | tr ' ' '\n' | awk '!a[$0]++' | tr '\n' ' ')
    fi
    
    weekdays=$(echo "$weekdays" | sed 's/ /,/g')
    local days
    if [ "$weekdays" != "Sunday,Monday,Tuesday,Wednesday,Thursday,Friday,Saturday" ]; then
        days="$weekdays"
    fi
    
    set_Rules "$RulesMACAddrList" "$timerangelist" "$days" "$rejectInterface" "${CONF}_maclist" 0
    delete_conntrack "$RulesMACAddrList" "$rejectInterface" 0
}

cleanup_ipset() {
    nameList=$(ipset list -name | grep "${CONF}_maclist")
    for name in $nameList; do
        ipset destroy $name 2>/dev/null
    done
}

Initialize() {
    logger -t timecontrol ""$1"ing"
    load_config
    
    if [ -z "$FW4" ]; then
        set_iptablesChains
        set_iptablesRules
        cleanup_ipset
    else
        set_nftablesChains
        set_nftablesRules
        set_daily_quota_hooks
    fi
    
    RulesMACAddrList=""
    
    config_foreach add_controlRules rule
    create_daily_counters
    
    local controltype="blacklist"
    if [ $TIMECONTROL_TYPE -ne 0 ]; then
        add_rejectRule
        controltype="whitelist"
    fi
    
    logger -t timecontrol "control type --> $controltype"
    logger -t timecontrol ""$1"ed"
}

set_nftablesChains() {
    if nft list chain inet fw4 timecontrol_forward >/dev/null 2>&1; then
        nft flush chain inet fw4 timecontrol_forward
    else
        nft add chain inet fw4 timecontrol_forward
    fi
    
    if nft list chain inet fw4 timecontrol_dstnat >/dev/null 2>&1; then
        nft flush chain inet fw4 timecontrol_dstnat
    else
        nft add chain inet fw4 timecontrol_dstnat
    fi

    if nft list chain inet fw4 timecontrol_quota >/dev/null 2>&1; then
        nft flush chain inet fw4 timecontrol_quota
    else
        nft add chain inet fw4 timecontrol_quota
    fi
}

set_nftablesRules() {
    TIMECONTROL_STRONG=$(config_n_get "$CONF" "config" "strong" 0)
    local wanInterface=$(config_n_get "$CONF" "config" "wanInterface")
    ip4_address=$(ip addr show br-lan 2>/dev/null | awk '/inet /{print $2}' | tr '\n' ',' | sed 's/,$//')
    ip6_address=$(ip addr show br-lan 2>/dev/null | awk '/inet6 /{print $2}' | tr '\n' ',' | sed 's/,$//')
    
    for chain in forward dstnat mangle_prerouting; do
        local jumpChain ip4_daddr_param ip6_daddr_param
        oifname_param=""
        case $chain in
            forward)
                jumpChain="timecontrol_forward"
                if [ -n "$wanInterface" ]; then
                    wanInterface=\"$(echo $wanInterface | sed 's/ /","/g')\"
                    oifname_param="oifname { ${wanInterface} } "
                fi
            ;;
            dstnat)
                jumpChain="timecontrol_dstnat"
            ;;
            mangle_prerouting)
                jumpChain="timecontrol_forward"
                [ -n "$ip4_address" ] && ip4_daddr_param="ip daddr != { $ip4_address ,255.255.255.255} "
                [ -n "$ip6_address" ] && ip6_daddr_param="ip6 daddr != { $ip6_address } "
            ;;
            *) ;;
        esac
        
        first_rule=$(nft list chain inet fw4 $chain | sed -n '4p' | grep -E "$jumpChain")
        if [ -z "$first_rule" ]; then
            handles=$(nft -a list chain inet fw4 $chain | grep "$jumpChain" | awk '{print $NF}')
            delete_nftablesRules "$handles" "$chain"
            if [ "$chain" = "mangle_prerouting" ]; then
                [ $TIMECONTROL_STRONG -ne 1 ] && continue
                [ -n "$ip4_daddr_param" ] && nft "insert rule inet fw4 $chain $ip4_daddr_param counter jump $jumpChain comment \"!fw4: Time control\"" 2>/dev/null
                [ -n "$ip6_daddr_param" ] && nft "insert rule inet fw4 $chain $ip6_daddr_param counter jump $jumpChain comment \"!fw4: Time control\"" 2>/dev/null
            else
                nft "insert rule inet fw4 $chain $oifname_param counter jump $jumpChain comment \"!fw4: Time control\"" 2>/dev/null
            fi
            logger -t timecontrol "set rule position to first (chain: $chain)"
            [ $TIMECONTROL_STRONG -eq 1 ] && logger -t timecontrol "strong control --> enabled"
        else
            case $chain in
                forward)
                    oifname=$(nft -a list chain inet fw4 $chain | grep "$jumpChain" | head -n1 | sed -E 's/.*oifname[[:space:]]+//; s/[[:space:]]*counter.*//' | grep -oE '"[^"]+"' | tr -d '"' | tr '\n' ' ')
                    oifname=\"$(echo $oifname | sed 's/ /","/g')\"
                    if [ "$oifname" != "$wanInterface" ]; then
                        handles=$(nft -a list chain inet fw4 $chain | grep "$jumpChain" | awk '{print $NF}')
                        delete_nftablesRules "$handles" "$chain"
                        nft "insert rule inet fw4 $chain $oifname_param counter jump $jumpChain comment \"!fw4: Time control\"" 2>/dev/null
                        logger -t timecontrol "set rule position to first (chain: $chain)"
                    fi
                ;;
                mangle_prerouting)
                    if [ $TIMECONTROL_STRONG -ne 1 ]; then
                        rule_handles=$(nft -a list chain inet fw4 $chain | grep "$jumpChain" | awk '{print $NF}')
                        delete_nftablesRules "$rule_handles" "$chain"
                        logger -t timecontrol "strong control --> disabled"
                    fi
                ;;
                *) ;;
            esac
        fi
    done
}

delete_nftablesRules() {
    local rule_handles=$1
    local chain=$2
    for handle in $rule_handles; do
        nft delete rule inet fw4 $chain handle $handle >/dev/null 2>&1
    done
}

set_iptablesChains() {
    local jumpChain
    for table in filter nat; do
        case $table in
            filter)
                jumpChain="timecontrol_forward"
            ;;
            nat)
                jumpChain="timecontrol_dstnat"
            ;;
            *) ;;
        esac
        for ipt in iptables ip6tables; do
            case $ipt in
                ip6tables)
                    if [ -z "$FW3_IP6" ]; then
                        continue
                    fi
                ;;
                *) ;;
            esac
            
            if $ipt -w 1 -t $table -L $jumpChain >/dev/null 2>&1; then
                $ipt -w 1 -t $table -F $jumpChain
            else
                $ipt -w 1 -t $table -N $jumpChain
                $ipt -w 1 -t $table -F $jumpChain
            fi
        done
    done
}

set_iptablesRules() {
    local chain jumpChain
    for table in filter nat; do
        case $table in
            filter)
                chain="FORWARD"
                jumpChain="timecontrol_forward"
            ;;
            nat)
                chain="PREROUTING"
                jumpChain="timecontrol_dstnat"
            ;;
            *) ;;
        esac
        for ipt in iptables ip6tables; do
            case $ipt in
                ip6tables)
                    if [ -z "$FW3_IP6" ]; then
                        continue
                    fi
                ;;
                *) ;;
            esac
            
            first_rule=$($ipt -w 1 -t $table -S $chain | sed -n '2p')
            echo "$first_rule" | grep -q $jumpChain
            if [ $? -ne 0 ]; then
                while $ipt -w 1 -t $table -C $chain -j $jumpChain 2>/dev/null; do
                    $ipt -w 1 -t $table -D $chain -j $jumpChain 2>/dev/null
                done
                $ipt -w 1 -t $table -I $chain -j $jumpChain 2>/dev/null
                logger -t timecontrol "set rule position to first (cmd: $ipt, table: $table, chain: $chain)"
            fi
        done
    done
}

update_ruleTemporaryDuration() {
    local enable=$(config_n_get "$CONF" "$1" "enable" 0)
    local temporaryDuration=$(config_n_get "$CONF" "$1" "temporaryDuration" 0)
    
    if [ $temporaryDuration -le 0 ]; then
        return
    fi
    
    temporaryDuration=$(expr $temporaryDuration - 1)
    
    if [ $temporaryDuration -eq 0 ]; then
        IsUpdate=1
        uci -q delete timecontrol.$1.temporaryDuration
    else
        uci -q set timecontrol.$1.temporaryDuration=$temporaryDuration
    fi
    uci -q commit timecontrol
    
    logger -t timecontrol "updated rule's temporary duration to $temporaryDuration (ID: $1)"
}

update_temporaryDuration() {
    IsUpdate=0
    
    load_config
    config_foreach update_ruleTemporaryDuration rule
    
    if [ $IsUpdate -eq 1 ]; then
        Initialize flush
    fi
}

check_firstRule() {
    if [ -z "$FW4" ]; then
        set_iptablesRules
    else
        set_nftablesRules
    fi
}

reset_sleep_time() {
    SLEEPTIME=60
    logger -t timecontrol "reset sleep time"
}

start() {
    if [ -f "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE" 2>/dev/null)
        if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$PIDFILE" >/dev/null 2>&1
        fi
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && [ "$pid" -ne $$ ]; then
            logger -t timecontrol "already running"
            echo "timecontrol is already running"
            return 0
        fi
    fi
    
    echo $$ >"$PIDFILE"
    trap reset_sleep_time USR1
    trap stop SIGHUP SIGINT SIGQUIT SIGTERM EXIT
    
    init_daily_state
    Initialize start
    while true; do
        while [ $SLEEPTIME -gt 0 ]; do
            sleep 3
            SLEEPTIME=$(expr $SLEEPTIME - 3)
        done
        SLEEPTIME=60
        update_temporaryDuration
        update_daily_quotas
        check_firstRule
    done
}

stop() {
    logger -t timecontrol "stopping"
    persist_daily_state
    
    if [ -z "$FW4" ]; then
        local chain jumpChain
        for table in filter nat; do
            case $table in
                filter)
                    chain="FORWARD"
                    jumpChain="timecontrol_forward"
                ;;
                nat)
                    chain="PREROUTING"
                    jumpChain="timecontrol_dstnat"
                ;;
                *) ;;
            esac
            for ipt in iptables ip6tables; do
                while $ipt -w 1 -t $table -C $chain -j $jumpChain 2>/dev/null; do
                    $ipt -w 1 -t $table -D $chain -j $jumpChain 2>/dev/null
                done
            done
            iptables_w -t $table -F $jumpChain
            iptables_w -t $table -X $jumpChain
        done
        cleanup_ipset
    else
        for chain in forward dstnat mangle_prerouting; do
            local jumpChain
            case $chain in
                dstnat)
                    jumpChain="timecontrol_dstnat"
                ;;
                *)
                    jumpChain="timecontrol_forward"
                ;;
            esac
            
            rule_handles=$(nft -a list chain inet fw4 $chain | grep "$jumpChain" | awk '{print $NF}')
            delete_nftablesRules "$rule_handles" "$chain"
        done
        rule_handles=$(nft -a list chain inet fw4 mangle_postrouting 2>/dev/null | grep 'timecontrol_quota' | awk '{print $NF}')
        delete_nftablesRules "$rule_handles" mangle_postrouting
        nft delete chain inet fw4 timecontrol_forward >/dev/null 2>&1
        nft delete chain inet fw4 timecontrol_dstnat >/dev/null 2>&1
        nft delete chain inet fw4 timecontrol_quota >/dev/null 2>&1
    fi
    logger -t timecontrol "stopped"
    
    if [ "$(service timecontrol status)" != "running" ]; then
        if [ -f "$PIDFILE" ]; then
            rm -f "$PIDFILE" >/dev/null 2>&1
        fi
    fi
    trap - SIGHUP SIGINT SIGQUIT SIGTERM EXIT USR1
    logger -t timecontrol "cleanup done"
    
    exit 0
}

case "$1" in
    stop)
        if [ -f "$PIDFILE" ]; then
            pid=$(cat "$PIDFILE" 2>/dev/null)
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                kill -SIGTERM "$pid" 2>/dev/null
            else
                stop
            fi
        else
            stop
        fi
    ;;
    flush)
        if [ -f "$PIDFILE" ]; then
            pid=$(cat "$PIDFILE" 2>/dev/null)
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                kill -USR1 "$pid" 2>/dev/null
            fi
        fi
        Initialize flush
    ;;
    *)
        start
    ;;
esac
